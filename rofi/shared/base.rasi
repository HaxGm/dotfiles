/*
 * Shared rofi chrome: the window frame, the input bar, and everything both
 * themes render identically. Importing themes override what differs —
 * window width, the entry placeholder, and the listview/element geometry.
 */

@import "colors.rasi"
@import "fonts.rasi"

/* Centred, hairline border on a rounded corner. Width set by the importer. */
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    x-offset: 0px;
    y-offset: 0px;
    margin: 0px;
    padding: 0px;
    border: 1px solid;
    border-radius: 16px;
    border-color: @subtle-border;
    background-color: @background;
    cursor: "default";
}

/* Search box on top, list underneath, 10px of air between and around. */
mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 10px;
    margin: 0px;
    padding: 10px;
    border: 0px solid;
    border-radius: 16px;
    border-color: @selected;
    background-color: transparent;
}

inputbar {
    children: [ "prompt", "entry" ];
    spacing: 10px;
    margin: 0px;
    padding: 12px 14px;
    border: 1px solid;
    border-radius: 16px;
    border-color: @subtle-border;
    background-color: @background;
    text-color: @foreground;
}

prompt {
    background-color: inherit;
    text-color: inherit;
}

entry {
    placeholder-color: @subtle;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

/* Shown when a mode fails to load; matches the inputbar's frame. */
error-message {
    padding: 10px;
    border: 1px solid;
    border-radius: 16px;
    border-color: @subtle-border;
    background-color: black / 10%;
    text-color: @foreground;
}

textbox {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: @foreground;
    highlight: none;
}
