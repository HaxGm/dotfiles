/*
 * Rofi — GitHub Dark
 *
 * A centred grid launcher: six columns of three, big icons, label under each.
 * Colours come from colors/<scheme>.rasi and the font from shared/fonts.rasi,
 * both pulled in via the shared/ imports below. Nothing here hardcodes a
 * palette except the few accent shades used for borders and the selection,
 * which have no @named equivalent.
 */

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

/* Outer window. 750px wide, centred, hairline border on a rounded corner. */
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 750px;
    x-offset: 0px;
    y-offset: 0px;
    margin: 0px;
    padding: 0px;
    border: 1px solid;
    border-radius: 16px;
    border-color: #6e768166;
    background-color: @background;
    cursor: "default";
}

/* Search box on top, grid underneath, 10px of air between and around. */
mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 10px;
    margin: 0px;
    padding: 10px;
    border: 0px solid;
    border-radius: 16px;
    border-color: @selected;
    background-color: transparent;
}

inputbar {
    children: [ "prompt", "entry" ];
    spacing: 10px;
    margin: 0px;
    padding: 12px 14px;
    border: 1px solid;
    border-radius: 16px;
    border-color: #6e768166;
    background-color: @background;
    text-color: @foreground;
}

/* The magnifier glyph from display-drun. */
prompt {
    background-color: inherit;
    text-color: inherit;
}

entry {
    placeholder: "Search";
    placeholder-color: #6e7681FF;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
}

/*
 * Fixed 6x3 grid. fixed-height/fixed-columns keep the window from resizing as
 * results are filtered, and the scrollbar is off — cycling wraps instead.
 */
listview {
    columns: 6;
    lines: 3;
    layout: vertical;
    cycle: true;
    dynamic: true;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 16px;
    border-color: @selected;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
}

/* One app: icon stacked over its name, 15px apart. */
element {
    orientation: vertical;
    spacing: 15px;
    margin: 0px;
    padding: 20px 10px;
    border: 0px solid;
    border-radius: 16px;
    border-color: @selected;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

/* Selection: blue-tinted fill, brighter blue border and label. */
element selected.normal {
    border: 1px solid;
    border-radius: 16px;
    border-color: #79c0ffB3;
    background-color: #0d2240;
    text-color: #79c0ffFF;
}

element-icon {
    size: 64px;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
}

/* Shown when a mode fails to load; matches the inputbar's frame. */
error-message {
    padding: 10px;
    border: 1px solid;
    border-radius: 16px;
    border-color: #6e768166;
    background-color: black / 10%;
    text-color: @foreground;
}

textbox {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: @foreground;
    highlight: none;
}
