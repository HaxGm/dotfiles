/*
 * Rofi — GitHub Dark, app launcher.
 *
 * A centred grid launcher
 */

@import "shared/base.rasi"

configuration {
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

window {
    width: 750px;
}

entry {
    placeholder: "Search";
}

/*
 * Fixed 6x3 grid. fixed-height/fixed-columns keep the window from resizing as
 * results are filtered, and the scrollbar is off — cycling wraps instead.
 */
listview {
    columns: 6;
    lines: 3;
    layout: vertical;
    cycle: true;
    dynamic: true;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 16px;
    border-color: @selected;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
}

/* One app: icon stacked over its name, 15px apart. */
element {
    orientation: vertical;
    spacing: 15px;
    margin: 0px;
    padding: 20px 10px;
    border: 0px solid;
    border-radius: 16px;
    border-color: @selected;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

/* Selection: blue-tinted fill, brighter blue border and label. */
element selected.normal {
    border: 1px solid;
    border-radius: 16px;
    border-color: @accent-border;
    background-color: @accent-fill;
    text-color: @accent;
}

element-icon {
    size: 64px;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
}
