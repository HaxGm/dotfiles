{
    "clock": {
        "interval": 60,
        "timezone": "Europe/Warsaw",
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b · %H:%M}",
        "tooltip": true,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#e6edf3'><b>{}</b></span>",
                "weekdays": "<span color='#79c0ff'><b>{}</b></span>",
                "days": "<span color='#b1bac4'>{}</span>",
                "today": "<span color='#3fb950'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
