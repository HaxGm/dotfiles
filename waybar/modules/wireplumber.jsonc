{
    "wireplumber#sink": {
        "format": "<span color='#d2a8ff'>{icon}</span> {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 2
    }
}
